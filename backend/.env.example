# Development defaults. On a server, deploy/deploy.sh writes a production .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional: shared file cache directory (recommended in production)
DJANGO_CACHE_DIR=
HERE_API_KEY=
